# Copy this file to .env.local and fill in your Supabase keys.
# Without them the app still runs, but saves to this browser only (no sharing).
# Keys live under: Supabase Dashboard > Project Settings > API Keys

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Use whichever key your dashboard shows. New projects list a "publishable" key;
# older ones list a legacy "anon" key. Set one of these two — not both.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Never put the secret / service_role key here. Anything prefixed NEXT_PUBLIC_
# is compiled into the JavaScript the browser downloads.
